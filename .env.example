# Telegram Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_SURVEY_DELAY=10

# SQLite Database
DB_DEBUG=
DB_FILE=/path/to/sherangthebell.db

# MQTT Broker Configuration
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_CLIENT_NAME=sherangthebell

# MQTT Topics (configurable API endpoints)
# These can be customized to match your specific requirements
MQTT_TOPIC_STATUS=sherangthebell/status
MQTT_TOPIC_BELL=sherangthebell/bell
MQTT_TOPIC_TAKE=sherangthebell/take
